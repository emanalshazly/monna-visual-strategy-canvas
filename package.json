{
  "name": "visual-strategy-canvas-generator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env.local server-dist/server/index.js",
    "start:test": "node scripts/start-test-server.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "check:secrets": "node scripts/check-client-secrets.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@google/genai": "^1.30.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "openai": "^6.16.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/ui": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@playwright/test": "^1.49.1",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.4.0",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "prettier": "^3.4.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.11",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  },
  "overrides": {
    "rollup": "^4.59.0",
    "ws": "^8.21.0"
  }
}
