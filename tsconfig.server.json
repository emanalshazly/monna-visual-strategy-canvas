{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "server-dist",
    "rootDir": "."
  },
  "include": ["server/**/*.ts", "constants.ts", "types.ts"],
  "exclude": ["server/**/*.test.ts"]
}
